{
  "headers": [
    {
      "source": "/media/(.*)\\.m3u8",
      "headers": [{ "key": "Content-Type", "value": "application/vnd.apple.mpegurl" }]
    },
    {
      "source": "/media/(.*)\\.ts",
      "headers": [{ "key": "Content-Type", "value": "video/mp2t" }]
    },
    {
      "source": "/media/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
